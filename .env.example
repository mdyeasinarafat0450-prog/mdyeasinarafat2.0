# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection, used by the running app. On Vercel use Supabase's
# TRANSACTION (connection-pooled) URL so concurrent serverless functions do not
# exhaust Postgres connections.
#   postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
#
# The `pgbouncer=true` + `connection_limit=1` suffix is REQUIRED for Supabase's
# transaction pooler, otherwise Prisma errors with "prepared statements" errors.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection, used ONLY for schema migrations.
# The transaction pooler cannot run DDL, so `prisma migrate` needs this.
# Supabase: Project Settings -> Database -> Connection string -> URI (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Sessions ────────────────────────────────────────────────────────────────
# REQUIRED. Admin sessions are signed with this key, so anyone who knows it
# can forge an admin login. Generate one with:  openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# ── Seeded admin account (used only by `npm run db:seed`) ───────────────────
# REQUIRED to seed a fresh database. Password is hashed with bcrypt before
# storage; the plaintext is never written to the database or committed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password-of-12-plus-chars"
#
# NOTE: ADMIN_PASSWORD must be at least 12 characters.
# NOTE: re-seeding never resets the password of an existing admin account
#       (the upsert uses update: {}). To rotate a password you must update it
#       directly, or delete the admin row and re-seed.